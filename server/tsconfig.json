{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "paths": {
      "@brume/basketball": ["../packages/basketball/src/index.ts"],
      "@brume/ocr-engine": ["../packages/ocr-engine/src/index.ts"]
    }
  },
  "include": ["src", "test", "build.mjs"]
}
