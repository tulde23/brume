{
  "expo": {
    "name": "InkStat",
    "slug": "inkstat",
    "scheme": "inkstat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.inkstat.app"
    },
    "android": {
      "package": "com.inkstat.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F6E75",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "InkStat uses the camera to photograph paper scoresheets.",
          "photosPermission": "InkStat reads scoresheet photos you choose from your library."
        }
      ],
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "forceCxx20": true,
          "enableOpenCLAndHexagon": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "x86_64"
            ],
            "minSdkVersion": 26,
            "extraProguardRules": "# ML Kit (Gemini Nano) creates its components by reflection; R8 must keep them.\n-keep class com.google.mlkit.** { *; }\n-keep class * implements com.google.firebase.components.ComponentRegistrar { <init>(); }"
          }
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F5F7",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0E1116"
          }
        }
      ]
    ]
  }
}
