{
  "expo": {
    "name": "Brume",
    "slug": "brume",
    "scheme": "brume",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brume.app"
    },
    "android": {
      "package": "com.brume.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F6E75",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Brume uses the camera to photograph paper scoresheets.",
          "photosPermission": "Brume reads scoresheet photos you choose from your library."
        }
      ],
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "forceCxx20": true,
          "enableOpenCLAndHexagon": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a", "x86_64"]
          }
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F5F7",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0E1116"
          }
        }
      ]
    ]
  }
}
